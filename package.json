{
  "name": "pixel-arcade",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check . && node scripts/check-boundaries.mjs",
    "new-game": "node scripts/new-game.mjs",
    "dev:hub": "npm run dev -w apps/hub",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --dir scripts && npm run test --workspaces --if-present",
    "build": "node scripts/build-all.mjs",
    "preview": "vite preview --config scripts/preview.config.mjs",
    "smoke:template": "node scripts/smoke-template.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
